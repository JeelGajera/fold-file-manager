    <!-- Hidden files. The wording here is load-bearing: this is a visibility
         control and must never read as protection. -->
    <string name="hidden_title">Hidden files</string>
    <string name="hidden_body">Files and folders whose name starts with a dot. Showing them changes what you see — it does not protect anything. For that, use the vault.</string>
    <string name="hidden_toggle">Show hidden files</string>
    <string name="hidden_callout_tag">NOT SECURITY</string>
    <string name="hidden_callout">Any app with storage access can read these files whether or not FOLD shows them.</string>
