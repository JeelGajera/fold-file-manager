    <!-- Onboarding -->
    <string name="onboarding_step">STEP %1$d OF 3</string>
    <string name="onboarding_title_1">Your phone has files this phone refuses to show you</string>
    <string name="onboarding_title_2">What FOLD reads, and what it never sends</string>
    <string name="onboarding_title_3">One permission, then you are done</string>
    <string name="onboarding_body_1">Download a .md note, a .log, an .epub or a firmware image and most file apps act as if it does not exist. They read a media index, not your storage. FOLD reads the filesystem, so everything is there — visible, movable, shareable.</string>
    <string name="onboarding_body_2">FOLD reads file names, sizes, dates and, when you search contents, the text inside files you point it at. It has no account, no analytics and no server of its own.</string>
    <string name="onboarding_body_3">Android calls it All files access. It is the only way an app can list every folder on the device. Grant it and FOLD is complete; refuse it and FOLD still works inside the folders you pick.</string>
    <string name="onboarding_continue">CONTINUE</string>
    <string name="onboarding_grant">ALLOW ALL FILES ACCESS</string>
    <string name="onboarding_skip">SKIP</string>
    <string name="onboarding_why">WHY THIS MATTERS</string>
    <string name="onboarding_pick_folders">PICK FOLDERS INSTEAD</string>
    <string name="onboarding_unavailable">This device has no screen for All files access. FOLD will work inside the folders you pick instead.</string>

