    <!-- Limited access -->
    <string name="limited_kicker">LIMITED ACCESS</string>
    <string name="limited_title">Working with what you allowed</string>
    <string name="limited_body">FOLD can open, move and share anything in these folders. Everything else on the device is invisible to it.</string>
