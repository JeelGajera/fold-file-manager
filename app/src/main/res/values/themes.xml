<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        A launch theme only. Everything visible after the first frame is drawn by
        FoldTheme in Compose; this exists so the window between process start and
        first composition is FOLD's ground rather than a white flash.

        The parent is an AppCompat theme because BiometricPrompt hosts a fragment
        and needs a FragmentActivity with an AppCompat-derived theme.
    -->
    <style name="Theme.Fold" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/fold_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>
</resources>
